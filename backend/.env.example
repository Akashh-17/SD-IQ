# Copy to .env and fill in. Never commit .env.

PORT=5000

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Secret: bypasses row-level security. Backend only, never the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres for the LangGraph checkpointer.
# Supabase -> Connect -> Session pooler (not Direct connection, not Transaction pooler)
DATABASE_URL=postgresql://postgres.your-project:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Upstash Redis: database -> REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# OpenRouter: openrouter.ai -> Keys. Model ids need the provider prefix.
# The free default supports tool calling and JSON-schema output. An API key is still required.
# Free requests have provider rate limits; no paid fallback is configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional: faster/cheaper model for intent + conversation style
# (defaults to OPENROUTER_MODEL)
OPENROUTER_FAST_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional override for custom-topic generation (otherwise uses OPENROUTER_MODEL).
PROBLEM_GENERATOR_MODEL=
# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT_MS=30000

# Groq (voice transcription only): console.groq.com -> API Keys
GROQ_API_KEY=

# Set to false in production to stop writing the debug log (sample.txt)
LOG_TO_FILE=true
